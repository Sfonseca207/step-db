# Conexión a Postgres (local: docker compose; Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://stepdb:stepdb@localhost:5432/stepdb
# Base usada por npm test
DATABASE_URL_TEST=postgres://stepdb:stepdb@localhost:5432/stepdb_test
DB_DRIVER=postgres
PORT=8787
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-un-secreto-aleatorio
# URL pública de la app (en local, la de Vite)
BETTER_AUTH_URL=http://localhost:5173
# Correos que pueden registrarse, separados por comas
ALLOWED_EMAILS=tu-correo@ejemplo.com,qa@stepdb.local
